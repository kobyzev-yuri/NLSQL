# ProxyAPI Configuration
OPENAI_API_KEY=your_proxyapi_key_here
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2

# Database Configuration
DATABASE_URL=postgresql://postgres:1234@localhost:5432/test_docstructure

# Vanna AI Configuration
VECTOR_TABLE=vanna_vectors
TRAINING_DATA_DIR=training_data

# Client Schema Package Location
DOCSTRUCTURE_DIR=data/DocStructureSchema

# Embedding Model Configuration
HF_MODEL_NAME=intfloat/multilingual-e5-base

# Chunking Configuration
# Размеры чанков для разных типов контента
CHUNK_SIZE_DDL=8000
CHUNK_SIZE_DOCUMENTATION=3000
CHUNK_SIZE_QA=1000

# Перекрытия (overlap) для сохранения контекста на границах чанков
CHUNK_OVERLAP_DDL=0
CHUNK_OVERLAP_DOCUMENTATION=300
CHUNK_OVERLAP_QA=0

# Использовать умное разбиение по границам предложений/абзацев
CHUNK_USE_SMART_BOUNDARIES=true

# Примечание: Для определения оптимальных параметров запустите:
# python src/tools/analyze_chunking.py --dsn "$DATABASE_URL" --generate-config
